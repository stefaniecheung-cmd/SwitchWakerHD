# git archive (tools/switch/package_release.sh) writes the version and commit into the release zip
# (cmake/BuildInfo.cmake reads them when there is no .git)
cmake/version.txt export-subst

# Every text file is stored and checked out with LF, so merges against upstream never differ by
# line endings alone. Windows batch files keep CRLF (cmd.exe requires it).
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
